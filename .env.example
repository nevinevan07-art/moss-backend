# Server Configuration
PORT=3001
NODE_ENV=development

# Moss Semantic Search Credentials
# Get your project credentials at https://portal.usemoss.dev
MOSS_PROJECT_ID=your_moss_project_id_here
MOSS_PROJECT_KEY=your_moss_project_key_here
MOSS_INDEX_NAME=recallos-workspace

# Optional AI Key for Assistant Generation (if left empty, RecallOS uses high-fidelity grounded synthesis)
GEMINI_API_KEY=
OPENAI_API_KEY=
